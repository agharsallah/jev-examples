{
  // Shared by every examples/*/web/tsconfig.json. The output is plain ES modules
  // the browser loads directly (<script type="module">): no bundler, so every
  // relative import is written with its .js extension.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "removeComments": false,
    "newLine": "lf"
  }
}
